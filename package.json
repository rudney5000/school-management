{
  "name": "school-management",
  "version": "1.0.0",
  "packageManager": "pnpm@11.21.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:backend": "pnpm --filter @school/backend dev",
    "dev:frontend": "pnpm --filter @school/frontend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rudney5000/school-management.git"
  },
  "bugs": {
    "url": "https://github.com/rudney5000/school-management/issues"
  },
  "homepage": "https://github.com/rudney5000/school-management#readme",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "husky": "^8.0.3",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.3",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11.0.0"
  },
  "lint-staged": {
    "backend/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "frontend/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
