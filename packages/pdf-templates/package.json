  "dependencies": {
    "@react-pdf/renderer": "^3.4.0",
    "react": "18.3.1"
  },
  "peerDependencies": {
    "@react-pdf/renderer": "^3.4.0",
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@react-pdf/renderer": "^3.4.0",
    "@types/react": "^18.3.1",
    "@types/node": "^26.1.1",
    "typescript": "^5.4.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  }
