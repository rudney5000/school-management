{
  "name": "@school-hub/pdf-templates",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc && node --input-type=module -e \"import { cpSync } from 'node:fs'; cpSync('src/fonts', 'dist/fonts', {recursive:true})\""
