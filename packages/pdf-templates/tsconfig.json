{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "declaration": true,
    "jsx": "react-jsx",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "noEmitOnError": true,
    "types": [
      "node"
    ]
  },
  "include": ["src"]
}