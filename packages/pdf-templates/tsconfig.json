{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "verbatimModuleSyntax": false,
    "outDir": "dist",
    "declaration": true,
    "jsx": "react-jsx",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "noEmitOnError": true,
    "types": ["node"]
  },
  "include": ["src"]
}
